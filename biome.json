{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!copilot/com.github.copilot"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["evals/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/omp",
                      "**/omp/**",
                      "**/copilot",
                      "**/copilot/**",
                      "@agent-fold/omp",
                      "@agent-fold/omp/**",
                      "@agent-fold/copilot",
                      "@agent-fold/copilot/**",
                      "**/pi",
                      "**/pi/**",
                      "@agent-fold/pi",
                      "@agent-fold/pi/**",
                      "**/opencode-v2",
                      "**/opencode-v2/**",
                      "@agent-fold/opencode-v2",
                      "@agent-fold/opencode-v2/**"
                    ],
                    "message": "evals/ never imports an agent directory."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
  "name": "@agent-fold/omp",
  "private": true,
  "description": "Folds each finished omp run to the user's message and the final reply, so the main context stays a clean thread of decisions.",
  "type": "module",
  "license": "MIT",
  "author": "Sen Hung Wong",
  "keywords": [
    "omp",
    "omp-plugin",
    "context",
    "fold"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun test ./evals/behavior/*.eval.ts",
    "eval:providers": "bun test ./evals/providers/*.eval.ts",
    "measure": "bun evals/session-length/measure.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.8.7",
    "@oh-my-pi/pi-ai": "18.8.7",
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}

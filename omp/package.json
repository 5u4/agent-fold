{
  "name": "@agent-fold/omp",
  "private": true,
  "description": "Folds each finished omp run to the user's message and the final reply, so the main context stays a clean thread of decisions.",
  "type": "module",
  "license": "MIT",
  "author": "Sen Hung Wong",
  "keywords": [
    "omp",
    "omp-plugin",
    "context",
    "fold"
  ],
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "settings": {
      "skillCaptureRules": {
        "type": "boolean",
        "default": false,
        "description": "Inject agent-fold's managed-skill capture rules into the system prompt when OMP autolearn is on."
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun test --max-concurrency=4 ./evals/behavior.eval.ts",
    "eval:providers": "bun test ./evals/providers/*.eval.ts",
    "measure": "bun scripts/measure.ts"
  },
  "devDependencies": {
    "@agent-fold/evals": "workspace:*",
    "@oh-my-pi/pi-agent-core": "18.8.7",
    "@oh-my-pi/pi-ai": "18.8.7",
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
